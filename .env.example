# PennyWise environment template.
# Copy to `.env` (never commit `.env`) and replace the placeholder values.
# Nothing reads these yet; each variable becomes active in the phase noted beside it.

# --- PostgreSQL via Docker Compose (Phase 2) ---
POSTGRES_USER=pennywise
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pennywise_dev
# Host port published on 127.0.0.1. Use another port (e.g. 5433) if 5432 is taken.
POSTGRES_PORT=5432

# --- API (Phase 1/2) ---
# development | test | production
NODE_ENV=development
PORT=3000
# Exact browser origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pennywise:change-me-local-only@127.0.0.1:5432/pennywise_dev?schema=public

# --- Web (Phase 6) ---
# WARNING: every VITE_ variable is bundled into public browser JavaScript. Never put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
