{
  "name": "pennywise",
  "version": "0.0.0",
  "private": true,
  "description": "Learning-first personal expense tracker (React, NestJS, PostgreSQL, Prisma).",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:hooks": "node --test \"scripts/hooks/*.test.mjs\"",
    "dev:api": "npm run start:dev -w @pennywise/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @pennywise/api",
    "db:deploy": "npm run db:deploy -w @pennywise/api",
    "db:seed": "npm run db:seed -w @pennywise/api",
    "db:validate": "npm run db:validate -w @pennywise/api"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
